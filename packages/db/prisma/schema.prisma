// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubscriptionTier {
  FREE
  PRO
  API
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIALING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum InstrumentStatus {
  ACTIVE
  HALTED
  DELISTED
}

enum PortfolioTxSide {
  BUY
  SELL
}

enum NewsSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum SignalStrength {
  LOW
  MEDIUM
  HIGH
}

enum SignalType {
  RSI_OVERBOUGHT
  RSI_OVERSOLD
  MACD_BULLISH
  MACD_BEARISH
  BREAKOUT
  BREAKDOWN
  VOLUME_SPIKE
}

enum StockRating {
  STRONG_BUY
  BUY
  HOLD
  SELL
  STRONG_SELL
}

enum AiSentiment {
  BULLISH
  NEUTRAL
  BEARISH
}

enum AlertStatus {
  PENDING
  DELIVERED
  FAILED
}

// ─── Auth ─────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  name         String?
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  oauthAccounts OAuthAccount[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]
  watchlists    Watchlist[]
  portfolios    Portfolio[]
  alertRules    AlertRule[]

  // Personalization Relations
  activities           UserActivity[]
  interestProfile      UserInterestProfile?
  recommendationScores RecommendationScore[]
  notifications        PersonalizedNotification[]

  @@map("users")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique @map("user_id")
  tier      SubscriptionTier   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  renewalAt DateTime?          @map("renewal_at")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model ApiKey {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  keyHash    String       @unique @map("key_hash")
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?    @map("last_used_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("api_keys")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  familyId  String   @map("family_id")
  tokenHash String   @unique @map("token_hash")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String   // e.g. "google"
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ─── Market Data ──────────────────────────────────────────

model Exchange {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  market String

  instruments Instrument[]

  @@map("exchanges")
}

model Sector {
  id   String @id @default(uuid())
  name String @unique

  instruments Instrument[]

  @@map("sectors")
}

model Instrument {
  id         String           @id @default(uuid())
  symbol     String
  name       String
  exchangeId String           @map("exchange_id")
  sectorId   String?          @map("sector_id")
  industry   String?
  currency   String
  isin       String?
  status     InstrumentStatus @default(ACTIVE)
  tradable   Boolean          @default(true)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  exchange Exchange @relation(fields: [exchangeId], references: [id])
  sector   Sector?  @relation(fields: [sectorId], references: [id])

  watchlistItems     WatchlistItem[]
  portfolioPositions PortfolioPosition[]
  portfolioTxs       PortfolioTransaction[]
  newsInstruments    NewsInstrument[]
  signals            StockSignal[]
  stockScores        StockScore[]
  aiSummaries        AiSummary[]
  alertRules         AlertRule[]
  quotes             Quote[]
  candles            Candle[]
  recommendationScores RecommendationScore[]

  companyProfile           CompanyProfile?
  companyShareholders      CompanyShareholder[]
  companyDividends         CompanyDividend[]
  companyFinancialQuarters CompanyFinancialQuarter[]
  companyFinancialYears    CompanyFinancialYear[]
  marketKnowledgeChunks    MarketKnowledgeChunk[]

  @@unique([symbol, exchangeId])
  @@index([exchangeId])
  @@index([sectorId])
  @@map("instruments")
}

model Quote {
  id            String   @id @default(uuid())
  instrumentId  String   @map("instrument_id")
  symbol        String
  price         Decimal  @db.Decimal(24, 8)
  change        Decimal  @db.Decimal(24, 8)
  changePercent Decimal  @map("change_percent") @db.Decimal(10, 4)
  open          Decimal  @db.Decimal(24, 8)
  high          Decimal  @db.Decimal(24, 8)
  low           Decimal  @db.Decimal(24, 8)
  previousClose Decimal  @map("previous_close") @db.Decimal(24, 8)
  volume        Decimal  @db.Decimal(24, 8)
  value         Decimal  @db.Decimal(24, 8)
  timestamp     DateTime
  asOf          DateTime @map("as_of")
  source        String

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId])
  @@index([symbol, asOf])
  @@map("quotes")
}

model Candle {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  timeframe    String // mapped to TimeframeEnum
  open         Decimal  @db.Decimal(24, 8)
  high         Decimal  @db.Decimal(24, 8)
  low          Decimal  @db.Decimal(24, 8)
  close        Decimal  @db.Decimal(24, 8)
  volume       Decimal  @db.Decimal(24, 8)
  value        Decimal? @db.Decimal(24, 8)
  timestamp    DateTime
  source       String

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe])
  @@index([timestamp])
  @@map("candles")
}

model RawTick {
  time   DateTime
  symbol String
  price  Decimal  @db.Decimal(24, 8)
  volume BigInt

  @@id([symbol, time])
  @@map("raw_ticks")
}

// ─── Watchlists ───────────────────────────────────────────

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User            @relation(fields: [userId], references: [id])
  items WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id           String   @id @default(uuid())
  watchlistId  String   @map("watchlist_id")
  instrumentId String   @map("instrument_id")
  addedAt      DateTime @default(now()) @map("added_at")

  watchlist  Watchlist  @relation(fields: [watchlistId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([watchlistId, instrumentId])
  @@index([instrumentId])
  @@map("watchlist_items")
}

// ─── Portfolios ───────────────────────────────────────────

model Portfolio {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  baseCurrency String   @map("base_currency")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User                   @relation(fields: [userId], references: [id])
  positions    PortfolioPosition[]
  transactions PortfolioTransaction[]
  snapshots    PortfolioSnapshot[]

  @@index([userId])
  @@map("portfolios")
}

model PortfolioPosition {
  id           String   @id @default(uuid())
  portfolioId  String   @map("portfolio_id")
  instrumentId String   @map("instrument_id")
  quantity     Decimal  @db.Decimal(24, 8)
  averageCost  Decimal  @map("average_cost") @db.Decimal(24, 8)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("portfolio_positions")
}

model PortfolioTransaction {
  id           String          @id @default(uuid())
  portfolioId  String          @map("portfolio_id")
  instrumentId String          @map("instrument_id")
  side         PortfolioTxSide
  quantity     Decimal         @db.Decimal(24, 8)
  price        Decimal         @db.Decimal(24, 8)
  fee          Decimal         @default(0) @db.Decimal(24, 8)
  executedAt   DateTime        @map("executed_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([portfolioId, executedAt])
  @@index([instrumentId])
  @@map("portfolio_transactions")
}

// ─── News ─────────────────────────────────────────────────

model NewsArticle {
  id             String         @id @default(uuid())
  headline       String
  summary        String?
  content        String?
  url            String         @unique
  source         String
  language       String
  sentiment      NewsSentiment?
  relevanceScore Decimal?       @map("relevance_score") @db.Decimal(10, 4)
  publishedAt    DateTime       @map("published_at")
  ingestedAt     DateTime       @default(now()) @map("ingested_at")

  newsInstruments NewsInstrument[]

  @@index([publishedAt])
  @@index([source])
  @@index([sentiment])
  @@map("news_articles")
}

model NewsInstrument {
  newsId       String @map("news_id")
  instrumentId String @map("instrument_id")

  newsArticle NewsArticle @relation(fields: [newsId], references: [id])
  instrument  Instrument  @relation(fields: [instrumentId], references: [id])

  @@id([newsId, instrumentId])
  @@index([instrumentId])
  @@map("news_instruments")
}

// ─── Intelligence ─────────────────────────────────────────

model StockSignal {
  id           String         @id @default(uuid())
  instrumentId String         @map("instrument_id")
  type         SignalType
  strength     SignalStrength
  score        Decimal        @db.Decimal(10, 4)
  value        Decimal?       @db.Decimal(24, 8)
  explanation  String?
  detectedAt   DateTime       @map("detected_at")
  expiresAt    DateTime?      @map("expires_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, detectedAt])
  @@index([type, detectedAt])
  @@index([expiresAt])
  @@map("signals")
}

model StockScore {
  id                String      @id @default(uuid())
  instrumentId      String      @map("instrument_id")
  score             Decimal     @db.Decimal(10, 4)
  rating            StockRating
  technicalScore    Decimal     @map("technical_score") @db.Decimal(10, 4)
  fundamentalsScore Decimal     @map("fundamentals_score") @db.Decimal(10, 4)
  momentumScore     Decimal     @map("momentum_score") @db.Decimal(10, 4)
  valuationScore    Decimal     @map("valuation_score") @db.Decimal(10, 4)
  sentimentScore    Decimal     @map("sentiment_score") @db.Decimal(10, 4)
  asOf              DateTime    @map("as_of")

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, asOf])
  @@map("stock_scores")
}

model AiSummary {
  id           String      @id @default(uuid())
  instrumentId String      @map("instrument_id")
  summary      String
  sentiment    AiSentiment
  confidence   Decimal     @db.Decimal(10, 4)
  drivers      Json
  risks        Json
  model        String
  generatedAt  DateTime    @map("generated_at")
  expiresAt    DateTime?   @map("expires_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, generatedAt])
  @@index([expiresAt])
  @@map("ai_summaries")
}

// ─── Alerts ───────────────────────────────────────────────

model AlertRule {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  instrumentId String   @map("instrument_id")
  type         String
  condition    String
  threshold    Decimal  @db.Decimal(24, 8)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  user       User         @relation(fields: [userId], references: [id])
  instrument Instrument   @relation(fields: [instrumentId], references: [id])
  events     AlertEvent[]

  @@index([userId])
  @@index([instrumentId])
  @@map("alert_rules")
}

model AlertEvent {
  id             String      @id @default(uuid())
  alertRuleId    String      @map("alert_rule_id")
  triggeredValue Decimal     @map("triggered_value") @db.Decimal(24, 8)
  triggeredAt    DateTime    @map("triggered_at")
  deliveredAt    DateTime?   @map("delivered_at")
  status         AlertStatus @default(PENDING)

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id])

  @@index([alertRuleId, triggeredAt])
  @@map("alert_events")
}

// ─── Cá nhân hóa & Hành vi Người dùng ──────────────────────────

enum ActivityType {
  VIEW_STOCK
  CLICK_NEWS
  SEARCH_SYMBOL
  VIEW_SECTOR
  INTERACT_AI
  ADD_WATCHLIST
  ADD_PORTFOLIO
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model UserActivity {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  activityType ActivityType @map("activity_type")
  symbol       String?
  sectorId     String?      @map("sector_id")
  metadata     Json?
  timestamp    DateTime     @default(now()) @map("timestamp")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([symbol])
  @@map("user_activities")
}

model UserInterestProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  preferredSectors Json
  viewedStocks    Json
  investmentStyle String   @default("NEUTRAL")
  riskTolerance   Decimal  @default(0.50) @map("risk_tolerance") @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_interest_profiles")
}

model RecommendationScore {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  instrumentId String   @map("instrument_id")
  symbol       String
  score        Decimal  @db.Decimal(10, 4)
  reasons      Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([userId, score])
  @@map("recommendation_scores")
}

model PortfolioSnapshot {
  id            String   @id @default(uuid())
  portfolioId   String   @map("portfolio_id")
  totalValue    Decimal  @map("total_value") @db.Decimal(24, 8)
  cashBalance   Decimal  @map("cash_balance") @db.Decimal(24, 8)
  unrealizedPnl Decimal  @map("unrealized_pnl") @db.Decimal(24, 8)
  realizedPnl   Decimal  @map("realized_pnl") @db.Decimal(24, 8)
  volatility    Decimal  @db.Decimal(10, 4)
  allocation    Json
  recordedAt    DateTime @default(now()) @map("recorded_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, recordedAt])
  @@map("portfolio_snapshots")
}

model PersonalizedNotification {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  title         String
  body          String
  priority      NotificationPriority @default(MEDIUM)
  relatedSymbol String?              @map("related_symbol")
  metadata      Json?
  isRead        Boolean              @default(false) @map("is_read")
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("personalized_notifications")
}

model CompanyProfile {
  id                String   @id @default(uuid())
  instrumentId      String   @unique @map("instrument_id")
  description       String   @db.Text
  industry          String
  management        Json     // Lưu danh sách ban lãnh đạo: Array<{ name: string, position: string }>
  charterCapital    Decimal  @map("charter_capital") @db.Decimal(24, 8) // Vốn điều lệ
  outstandingShares BigInt   @map("outstanding_shares") // Cổ phiếu lưu hành
  beta              Decimal  @db.Decimal(5, 2)
  eps               Decimal  @db.Decimal(24, 8)
  pe                Decimal  @db.Decimal(10, 2)
  pb                Decimal  @db.Decimal(10, 2)
  dividendYield     Decimal  @map("dividend_yield") @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model CompanyShareholder {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  name         String
  shares       BigInt
  percentage   Decimal  @db.Decimal(5, 2)
  isForeign    Boolean  @default(false) @map("is_foreign")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, name])
  @@index([instrumentId])
  @@map("company_shareholders")
}

model CompanyDividend {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  exDate       DateTime @map("ex_date")
  type         String
  rate         String
  value        Decimal? @db.Decimal(24, 8)
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, exDate, type])
  @@index([instrumentId])
  @@map("company_dividends")
}

model CompanyFinancialQuarter {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  quarter      String
  revenue      Decimal  @db.Decimal(24, 8)
  grossProfit  Decimal  @map("gross_profit") @db.Decimal(24, 8)
  netProfit    Decimal  @map("net_profit") @db.Decimal(24, 8)
  roe          Decimal? @db.Decimal(5, 2)
  roa          Decimal? @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, quarter])
  @@index([instrumentId])
  @@map("company_financial_quarters")
}

model CompanyFinancialYear {
  id           String   @id @default(uuid())
  instrumentId String   @map("instrument_id")
  year         String
  revenue      Decimal  @db.Decimal(24, 8)
  grossProfit  Decimal  @map("gross_profit") @db.Decimal(24, 8)
  netProfit    Decimal  @map("net_profit") @db.Decimal(24, 8)
  roe          Decimal  @db.Decimal(5, 2)
  roa          Decimal  @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, year])
  @@index([instrumentId])
  @@map("company_financial_years")
}

model MarketKnowledgeChunk {
  id           String   @id @default(uuid())
  instrumentId String?  @map("instrument_id")
  symbol       String?
  content      String   @db.Text
  type         String   // "profile_description" | "news" | "technical_signals_summary"
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  embedding    Float[]

  @@index([symbol])
  @@index([type])
  @@map("market_knowledge_chunks")
}


