{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "forceExit": true,
  "moduleNameMapper": {
    "^@stock-intel/db$": "<rootDir>/../../../packages/db/src",
    "^@stock-intel/config$": "<rootDir>/../../../packages/config/src",
    "^@stock-intel/contracts$": "<rootDir>/../../../packages/contracts/src",
    "^@stock-intel/utils$": "<rootDir>/../../../packages/utils/src"
  }
}
