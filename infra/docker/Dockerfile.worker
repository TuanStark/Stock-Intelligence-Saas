# ─── STAGE 1: Base (Nền tảng Debian 12 Bookworm) ─────────────
FROM node:22-bookworm-slim AS base
ARG WORKER=ingestion
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ─── STAGE 2: Builder ─────────────────────────────────────────
FROM base AS builder
ARG WORKER=ingestion
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/db/package.json ./packages/db/
COPY packages/utils/package.json ./packages/utils/
COPY apps/worker-${WORKER}/package.json ./apps/worker-${WORKER}/

RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY apps/worker-${WORKER}/ ./apps/worker-${WORKER}/

RUN pnpm --filter @stock-intel/db db:generate
RUN pnpm --filter @stock-intel/worker-${WORKER}... build

# Cô lập worker dependencies
RUN pnpm --filter @stock-intel/worker-${WORKER} --prod deploy --legacy /app/pruned

# Khắc phục Prisma client mà pnpm deploy bỏ sót
RUN cp -r /app/node_modules/.pnpm/@prisma+client*/node_modules/.prisma /app/pruned/node_modules/
RUN cp -r /app/node_modules/.pnpm/@prisma+client*/node_modules/.prisma /app/pruned/node_modules/.pnpm/@prisma+client*/node_modules/

# Cleanup & chown
RUN find /app/pruned/dist -name "*.map" -type f -delete \
    && rm -rf /app/pruned/node_modules/@prisma/engines \
    && rm -rf /app/pruned/node_modules/prisma \
    && chown -R 65532:65532 /app/pruned

# ─── STAGE 3: Runner (Google Distroless - Debian 12) ───────────
FROM gcr.io/distroless/nodejs22-debian12 AS runner
WORKDIR /app

ENV NODE_ENV=production

USER 65532:65532

COPY --from=builder /app/pruned ./

CMD ["dist/main.js"]
