# ─── Build stage ─────────────────────────────────────────
FROM node:22-alpine AS builder
ARG WORKER=ingestion
RUN corepack enable pnpm

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/ packages/
COPY apps/worker-${WORKER}/ apps/worker-${WORKER}/

RUN pnpm install --frozen-lockfile
RUN DATABASE_URL=postgresql://mock:mock@localhost:5432/mock_db pnpm db:generate
RUN pnpm --filter @stock-intel/worker-${WORKER}... build

# ─── Production stage ────────────────────────────────────
FROM node:22-alpine AS runner
ARG WORKER=ingestion
ENV WORKER=${WORKER}
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/worker-${WORKER}/dist ./apps/worker-${WORKER}/dist
COPY --from=builder /app/apps/worker-${WORKER}/node_modules ./apps/worker-${WORKER}/node_modules
COPY --from=builder /app/apps/worker-${WORKER}/package.json ./apps/worker-${WORKER}/package.json

CMD exec node apps/worker-${WORKER}/dist/main.js
