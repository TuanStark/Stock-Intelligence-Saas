# ─── Build stage ─────────────────────────────────────────
FROM node:22-alpine AS builder
ARG WORKER=ingestion
RUN apk add --no-cache openssl
RUN corepack enable pnpm

WORKDIR /app
RUN echo "node-linker=hoisted" > .npmrc

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/db/package.json ./packages/db/
COPY packages/utils/package.json ./packages/utils/
COPY apps/worker-${WORKER}/package.json ./apps/worker-${WORKER}/

RUN pnpm install

COPY packages/ packages/
COPY apps/worker-${WORKER}/ apps/worker-${WORKER}/

RUN DATABASE_URL=postgresql://mock:mock@localhost:5432/mock_db pnpm db:generate
RUN pnpm --filter @stock-intel/worker-${WORKER}... build

# ─── Production dependencies stage ───────────────────────
FROM node:22-alpine AS prod-deps
ARG WORKER=ingestion
RUN corepack enable pnpm

WORKDIR /app
RUN echo "node-linker=hoisted" > .npmrc

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/db/package.json ./packages/db/
COPY packages/utils/package.json ./packages/utils/
COPY apps/worker-${WORKER}/package.json ./apps/worker-${WORKER}/

RUN pnpm install --prod

# ─── Production stage ────────────────────────────────────
FROM node:22-alpine AS runner
ARG WORKER=ingestion
ENV WORKER=${WORKER}
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache openssl

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/worker-${WORKER}/dist ./apps/worker-${WORKER}/dist
COPY --from=builder /app/apps/worker-${WORKER}/package.json ./apps/worker-${WORKER}/package.json

CMD exec node apps/worker-${WORKER}/dist/main.js
