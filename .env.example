# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockintel

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI
OPENAI_API_KEY=sk-your-openai-key
LITELLM_API_BASE=http://localhost:4000

# Market Data
MARKET_DATA_API_KEY=your-market-data-api-key

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stockintel
MINIO_USE_SSL=false

# ─── APP PORTS CONFIGURATION (3005-3010 Safe Range) ─────────
WEB_PORT=3005
API_PORT=3006
WORKER_INGESTION_PORT=3007
WORKER_PROCESSING_PORT=3008
WORKER_AI_PORT=3009
WORKER_PAYMENT_PORT=3010

# ─── APP URLS ────────────────────────────────────────────────
NODE_ENV=development
WEB_URL=http://localhost:3005
API_URL=http://localhost:3006
NEXTAUTH_URL=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost:3006/api/v1
